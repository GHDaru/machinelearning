# Copie para .env (que é gitignored) e preencha. NUNCA commite o .env.
# Princípio V da constituição: credencial só em ambiente.

# --- modelo ---
# echo = sem rede, responde eco (default, bom para testes)
# openai = qualquer endpoint OpenAI-compatible
LLM_ADAPTER=echo
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
LLM_MODEL=

# --- persistência ---
# vazio = tudo em memória (some ao reiniciar). Em produção, um Postgres.
DATABASE_URL=

# --- rede ---
ALLOWED_ORIGINS=https://ghdaru.github.io,http://localhost:8080,http://127.0.0.1:8080

# --- limites ---
RATE_LIMIT_MSGS=20
RATE_LIMIT_TENTATIVAS=60
RATE_LIMIT_WINDOW_S=300
ALLOW_BYOK=true

# --- admin (rotas /telemetry e /suggestions) ---
# vazio = rotas de admin desabilitadas. Use um token longo e aleatório.
ADMIN_TOKEN=

# --- email de sugestões (opcional) ---
SUGGESTION_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
